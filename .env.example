# eBay application credentials (required).
# Create an app at https://developer.ebay.com/my/keys and copy the values:
#   EBAY_CLIENT_ID     = the "App ID (Client ID)"
#   EBAY_CLIENT_SECRET = the "Cert ID (Client Secret)"
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Environment: "production" (real listings) or "sandbox" (eBay test data).
EBAY_ENVIRONMENT=production

# Marketplace to search (default EBAY_GB).
EBAY_MARKETPLACE_ID=EBAY_GB

# Only return items located in this country. Defaults to the marketplace's
# country (GB for EBAY_GB). Set to ANY to search everywhere.
# EBAY_ITEM_LOCATION_COUNTRY=GB

# Buyer location: postage is calculated to this postcode. Keep it private.
EBAY_DELIVERY_COUNTRY=GB
EBAY_DELIVERY_POSTAL_CODE=

# HTTP transport only: shared bearer token (at least 32 characters).
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# MCP_AUTH_TOKEN=

# Optional network tuning.
# EBAY_TIMEOUT=20
# EBAY_MAX_RETRIES=3
