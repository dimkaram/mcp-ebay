{
  "mcpServers": {
    "ebay": {
      "command": "mcp-ebay",
      "args": ["serve"],
      "env": {
        "EBAY_CLIENT_ID": "${EBAY_CLIENT_ID}",
        "EBAY_CLIENT_SECRET": "${EBAY_CLIENT_SECRET}",
        "EBAY_ENVIRONMENT": "production",
        "EBAY_MARKETPLACE_ID": "EBAY_GB",
        "EBAY_DELIVERY_COUNTRY": "${EBAY_DELIVERY_COUNTRY}",
        "EBAY_DELIVERY_POSTAL_CODE": "${EBAY_DELIVERY_POSTAL_CODE}"
      }
    }
  }
}
